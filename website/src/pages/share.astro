---
import Layout from "../layouts/Layout.astro"
import { flightSilhouette } from "../../../app/composition/boot-silhouettes"

const SPEED_LINES = [
  { left: "79.17%", top: "16.11%", width: "13.33%", delay: "-0.2s", duration: "0.9s" },
  { left: "87.5%", top: "33.89%", width: "8.75%", delay: "-0.55s", duration: "0.8s" },
  { left: "77.08%", top: "62.22%", width: "15.83%", delay: "-0.75s", duration: "1.1s" },
  { left: "91.67%", top: "79.44%", width: "10%", delay: "-0.35s", duration: "0.85s" },
  { left: "83.33%", top: "90.56%", width: "12.92%", delay: "-0.6s", duration: "1s" },
]

const SPARKLES = [
  { left: "24.17%", top: "56.94%", width: "4.17%", delay: "-0.3s" },
  { left: "31.88%", top: "69.17%", width: "2.92%", delay: "-0.8s" },
  { left: "20%", top: "45.28%", width: "2.92%", delay: "-0.55s" },
]
---

<Layout title="ORAHAKO · Schedule" description="ORAHAKO Schedule" robots="noindex, nofollow">
  <div class="ba-page min-h-screen">
    <div class="mx-auto flex max-w-6xl flex-col gap-5 px-3 py-5 sm:px-6 sm:py-8">
      <!-- Top Editorial Bar -->
      <header class="ba-frame ba-header relative flex flex-col gap-4 p-4 sm:flex-row sm:items-center sm:justify-between sm:px-6 sm:py-5">
        <span class="ba-corner ba-corner-tl" aria-hidden="true"></span>
        <span class="ba-corner ba-corner-br" aria-hidden="true"></span>

        <div class="flex min-w-0 items-center gap-3.5">
          <!-- Miniature Bad Apple cinema badge -->
          <a
            href="/"
            class="ba-emblem shrink-0"
            aria-label="ORAHAKO"
            title="ORAHAKO"
          >
            <svg class="h-full w-full" viewBox="0 0 480 360" aria-hidden="true">
              <g transform="translate(0 35)">
                <path d={flightSilhouette} fill="currentColor" fill-rule="evenodd" />
              </g>
            </svg>
          </a>

          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <span class="ba-wordmark">ORAHAKO</span>
              <span id="share-masked-tag" class="ba-pill hidden"></span>
              <span id="share-exp-tag" class="ba-mono-meta hidden"></span>
            </div>
            <h1 id="share-title" class="mt-1 truncate text-lg font-semibold tracking-tight sm:text-xl">
              &nbsp;
            </h1>
          </div>
        </div>

        <!-- Week Controls -->
        <div id="week-controls" class="hidden flex-wrap items-center gap-1.5">
          <button id="btn-prev-week" type="button" class="ba-btn ba-btn-icon" aria-label="Prev">
            ←
          </button>
          <select id="week-select" class="ba-select" aria-label="Week"></select>
          <button id="btn-current-week" type="button" class="ba-btn ba-btn-inverted hidden"></button>
          <button id="btn-next-week" type="button" class="ba-btn ba-btn-icon" aria-label="Next">
            →
          </button>
        </div>
      </header>

      <!-- Bad Apple Loading Stage -->
      <section id="share-loading" class="ba-stage-wrap">
        <div class="ba-stage-box">
          <div class="ba-stage" aria-hidden="true">
            <span class="ba-stage-corner ba-stage-corner-top"></span>
            <span class="ba-stage-corner ba-stage-corner-bottom"></span>
            <div class="ba-artwork">
              {SPEED_LINES.map((line) => (
                <div
                  class="ba-speed-track"
                  style={`animation-delay:${line.delay};animation-duration:${line.duration}`}
                >
                  <span
                    class="ba-speed-bar"
                    style={`left:${line.left};top:${line.top};width:${line.width}`}
                  />
                </div>
              ))}
              {SPARKLES.map((sparkle) => (
                <div
                  class="ba-sparkle"
                  style={`left:${sparkle.left};top:${sparkle.top};width:${sparkle.width};animation-delay:${sparkle.delay}`}
                >
                  <svg class="block h-full w-full" viewBox="0 0 20 20">
                    <path d="m10 0 3 7 7 3-7 3-3 7-3-7-7-3 7-3Z" fill="currentColor" />
                  </svg>
                </div>
              ))}
              <div class="ba-flyer">
                <svg class="block h-full w-full" viewBox="0 0 480 360">
                  <g transform="translate(0 35)">
                    <path d={flightSilhouette} fill="currentColor" fill-rule="evenodd" />
                  </g>
                </svg>
              </div>
            </div>
            <span class="ba-frame-num">∞</span>
          </div>
          <div class="ba-stage-caption">
            <strong>ORAHAKO</strong>
            <span id="loading-label">LOADING</span>
          </div>
        </div>
      </section>

      <!-- Error / Expired Stage -->
      <section id="share-error" class="ba-stage-wrap hidden">
        <div class="ba-stage-box">
          <div class="ba-stage ba-stage-static" aria-hidden="true">
            <span class="ba-stage-corner ba-stage-corner-top"></span>
            <span class="ba-stage-corner ba-stage-corner-bottom"></span>
            <div class="ba-artwork">
              <div class="ba-flyer ba-flyer-still">
                <svg class="block h-full w-full opacity-35" viewBox="0 0 480 360">
                  <g transform="translate(0 35)">
                    <path d={flightSilhouette} fill="currentColor" fill-rule="evenodd" />
                  </g>
                </svg>
              </div>
            </div>
            <span class="ba-frame-num">404</span>
          </div>
          <div class="ba-stage-caption">
            <strong id="share-error-title">404</strong>
            <a id="share-error-home" href="/" class="ba-link">ORAHAKO</a>
          </div>
        </div>
      </section>

      <!-- Timetable Grid -->
      <main id="share-main" class="hidden">
        <div class="ba-frame relative overflow-hidden">
          <span class="ba-corner ba-corner-tl" aria-hidden="true"></span>
          <span class="ba-corner ba-corner-br" aria-hidden="true"></span>
          <div class="overflow-x-auto">
            <div id="timetable-shell" class="min-w-[680px]">
              <div
                id="timetable-header"
                class="ba-grid-header grid grid-cols-[3.75rem_repeat(7,minmax(0,1fr))]"
              ></div>
              <div
                id="timetable-body"
                class="relative grid grid-cols-[3.75rem_repeat(7,minmax(0,1fr))]"
              ></div>
            </div>
          </div>
        </div>
      </main>

      <!-- Minimal Footer -->
      <footer class="flex items-center justify-between px-1 py-1 text-[11px] tracking-widest uppercase opacity-55">
        <span id="footer-frame" class="font-mono">∞</span>
        <a href="/" class="font-mono font-semibold tracking-[0.2em] transition hover:opacity-100">
          ORAHAKO
        </a>
      </footer>
    </div>

    <!-- Detail Modal -->
    <div id="detail-modal" class="ba-modal-backdrop hidden" role="dialog" aria-modal="true">
      <div class="ba-modal relative">
        <span class="ba-corner ba-corner-tl" aria-hidden="true"></span>
        <span class="ba-corner ba-corner-br" aria-hidden="true"></span>
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0 space-y-1.5">
            <span id="detail-category" class="ba-pill"></span>
            <h3 id="detail-title" class="text-base font-semibold leading-snug"></h3>
          </div>
          <button id="detail-close" type="button" class="ba-btn ba-btn-icon" aria-label="Close">
            ✕
          </button>
        </div>
        <dl id="detail-rows" class="mt-4 space-y-2.5 text-xs"></dl>
      </div>
    </div>
  </div>

  <style>
    .ba-page {
      --paper: #ffffff;
      --ink: #0a0a0a;
      --ink-soft: rgba(10, 10, 10, 0.58);
      --ink-faint: rgba(10, 10, 10, 0.12);
      --ink-hairline: rgba(10, 10, 10, 0.07);
      --surface-subtle: rgba(10, 10, 10, 0.03);
      --card-bg: #ffffff;
      --card-border: rgba(10, 10, 10, 0.22);
      --hatch-a: rgba(10, 10, 10, 0.08);
      --hatch-b: rgba(10, 10, 10, 0.02);

      color: var(--ink);
      background-color: var(--paper);
      background-image: radial-gradient(var(--ink-faint) 1px, transparent 1px);
      background-size: 20px 20px;
    }

    @media (prefers-color-scheme: dark) {
      .ba-page {
        --paper: #0a0a0a;
        --ink: #ffffff;
        --ink-soft: rgba(255, 255, 255, 0.62);
        --ink-faint: rgba(255, 255, 255, 0.16);
        --ink-hairline: rgba(255, 255, 255, 0.08);
        --surface-subtle: rgba(255, 255, 255, 0.04);
        --card-bg: #111111;
        --card-border: rgba(255, 255, 255, 0.24);
        --hatch-a: rgba(255, 255, 255, 0.11);
        --hatch-b: rgba(255, 255, 255, 0.03);
      }
    }

    .ba-frame {
      background: var(--paper);
      border: 1px solid var(--ink-faint);
      box-shadow: 0 1px 0 var(--ink-hairline);
    }

    .ba-corner {
      position: absolute;
      z-index: 2;
      width: 12px;
      height: 12px;
      border-color: var(--ink);
      border-style: solid;
      pointer-events: none;
      opacity: 0.7;
    }

    .ba-corner-tl {
      top: -1px;
      left: -1px;
      border-width: 1.5px 0 0 1.5px;
    }

    .ba-corner-br {
      right: -1px;
      bottom: -1px;
      border-width: 0 1.5px 1.5px 0;
    }

    .ba-emblem {
      display: block;
      width: 52px;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background: #0a0a0a;
      color: #ffffff;
      border: 1px solid var(--ink);
      transition: transform 150ms ease;
    }

    .ba-emblem:hover {
      transform: scale(1.04);
    }

    .ba-wordmark {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.22em;
      line-height: 1;
    }

    .ba-mono-meta {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 10px;
      letter-spacing: 0.1em;
      color: var(--ink-soft);
    }

    .ba-pill {
      display: inline-flex;
      align-items: center;
      padding: 2px 7px;
      border: 1px solid var(--ink);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      line-height: 1.3;
    }

    .ba-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 32px;
      padding: 0 10px;
      border: 1px solid var(--ink-faint);
      background: var(--paper);
      color: var(--ink);
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      transition: background-color 120ms ease, color 120ms ease, border-color 120ms ease;
    }

    .ba-btn:hover:not(:disabled) {
      border-color: var(--ink);
      background: var(--ink);
      color: var(--paper);
    }

    .ba-btn:disabled {
      opacity: 0.3;
      cursor: not-allowed;
    }

    .ba-btn-icon {
      width: 32px;
      padding: 0;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }

    .ba-btn-inverted {
      border-color: var(--ink);
      background: var(--ink);
      color: var(--paper);
    }

    .ba-btn-inverted:hover:not(:disabled) {
      opacity: 0.85;
    }

    .ba-select {
      height: 32px;
      padding: 0 10px;
      border: 1px solid var(--ink-faint);
      background: var(--paper);
      color: var(--ink);
      font-size: 12px;
      font-weight: 500;
      outline: none;
      cursor: pointer;
    }

    .ba-select:focus {
      border-color: var(--ink);
    }

    .ba-grid-header {
      border-bottom: 1px solid var(--ink-faint);
      background: var(--surface-subtle);
    }

    /* Bad Apple Stage (matches BootSplash) */
    .ba-stage-wrap {
      display: grid;
      place-items: center;
      padding: 64px 16px;
    }

    .ba-stage-box {
      width: min(72vw, 240px);
    }

    .ba-stage {
      position: relative;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      color: #ffffff;
      background: #0a0a0a;
      border: 1px solid var(--ink);
    }

    .ba-artwork {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    .ba-flyer {
      position: absolute;
      inset: 0;
      animation: ba-flight-float 1.6s ease-in-out infinite;
    }

    .ba-flyer-still {
      animation: none;
    }

    .ba-speed-track {
      position: absolute;
      inset: 0;
      opacity: 0;
      animation: ba-speed-line 0.9s linear infinite;
    }

    .ba-speed-bar {
      position: absolute;
      height: 1.5px;
      border-radius: 999px;
      background: currentColor;
      transform: translateY(-50%);
    }

    .ba-sparkle {
      position: absolute;
      aspect-ratio: 1;
      opacity: 0;
      animation: ba-sparkle-trail 1.2s ease-in-out infinite;
    }

    .ba-stage-corner {
      position: absolute;
      z-index: 1;
      width: 16px;
      height: 16px;
      border-color: currentColor;
      border-style: solid;
      pointer-events: none;
    }

    .ba-stage-corner-top {
      top: 10px;
      left: 10px;
      border-width: 1px 0 0 1px;
    }

    .ba-stage-corner-bottom {
      right: 10px;
      bottom: 10px;
      border-width: 0 1px 1px 0;
    }

    .ba-frame-num {
      position: absolute;
      right: 12px;
      top: 10px;
      z-index: 1;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 9px;
      line-height: 1;
      letter-spacing: 0.14em;
    }

    .ba-stage-caption {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin-top: 12px;
    }

    .ba-stage-caption strong {
      font-size: 13px;
      letter-spacing: 0.18em;
    }

    .ba-stage-caption span,
    .ba-link {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 10px;
      letter-spacing: 0.1em;
      color: var(--ink-soft);
      text-decoration: none;
    }

    .ba-link:hover {
      color: var(--ink);
      text-decoration: underline;
    }

    /* Timetable cards */
    :global(.ba-card) {
      position: absolute;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      overflow: hidden;
      padding: 5px 6px;
      text-align: left;
      cursor: pointer;
      transition: transform 120ms ease, box-shadow 120ms ease, background-color 120ms ease;
    }

    :global(.ba-card:hover) {
      z-index: 20;
      transform: translateY(-1px);
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.16);
    }

    :global(.ba-card-course) {
      background: var(--card-bg);
      color: var(--ink);
      border: 1px solid var(--card-border);
      border-left-width: 3px;
    }

    :global(.ba-card-exam) {
      background: var(--ink);
      color: var(--paper);
      border: 1px solid var(--ink);
      z-index: 12;
    }

    :global(.ba-card-event) {
      background: var(--paper);
      color: var(--ink);
      border: 1px dashed var(--ink);
      z-index: 10;
    }

    :global(.ba-card-busy) {
      background: repeating-linear-gradient(
        -45deg,
        var(--hatch-a),
        var(--hatch-a) 5px,
        var(--hatch-b) 5px,
        var(--hatch-b) 10px
      );
      color: var(--ink);
      border: 1px solid var(--card-border);
    }

    /* Detail Modal */
    .ba-modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      background: rgba(0, 0, 0, 0.56);
      backdrop-filter: blur(4px);
    }

    .ba-modal-backdrop.hidden {
      display: none;
    }

    .ba-modal {
      width: 100%;
      max-width: 360px;
      padding: 20px;
      background: var(--paper);
      color: var(--ink);
      border: 1px solid var(--ink);
      box-shadow: 0 18px 48px rgba(0, 0, 0, 0.32);
    }

    @keyframes ba-flight-float {
      0%,
      100% {
        transform: translate3d(-1.67%, 1.11%, 0) rotate(-1deg);
      }
      50% {
        transform: translate3d(2.08%, -1.67%, 0) rotate(1deg);
      }
    }

    @keyframes ba-speed-line {
      0% {
        opacity: 0;
        transform: translate3d(25%, 0, 0);
      }
      15%,
      75% {
        opacity: 0.65;
      }
      100% {
        opacity: 0;
        transform: translate3d(-108.33%, 0, 0);
      }
    }

    @keyframes ba-sparkle-trail {
      0%,
      100% {
        opacity: 0;
        transform: translate3d(6px, -4px, 0) scale(0.4);
      }
      35% {
        opacity: 0.9;
      }
      70% {
        opacity: 0.45;
        transform: translate3d(-5px, 4px, 0) scale(1);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .ba-flyer,
      .ba-speed-track,
      .ba-sparkle {
        animation: none;
      }
    }
  </style>

  <script>
    interface SharedPeriod {
      section: number
      startTime: string
      endTime: string
    }

    interface SharedItem {
      title: string
      location?: string
      subtitle?: string
      category: "course" | "event" | "exam" | "busy"
      date?: string
      weekDay: number
      weekList?: number[]
      startSection?: number
      endSection?: number
      startTime?: string
      endTime?: string
    }

    interface SharedPayload {
      version: 1
      title: string
      masked?: boolean
      semester?: string
      termStartDate?: string
      totalWeeks: number
      timeZone?: string
      periods: SharedPeriod[]
      items: SharedItem[]
      createdAt: number
    }

    type Locale = "zh" | "en"

    function detectLocale(): Locale {
      const langs =
        Array.isArray(navigator.languages) && navigator.languages.length > 0
          ? navigator.languages
          : [navigator.language || "en"]
      for (const lang of langs) {
        if (typeof lang === "string" && lang.toLowerCase().startsWith("zh")) {
          return "zh"
        }
      }
      return "en"
    }

    const I18N = {
      zh: {
        scheduleSuffix: "日程",
        defaultTitle: "日程",
        maskedTag: "隐私遮罩",
        thisWeek: "本周",
        weekOption: (w: number, isCurrent: boolean) =>
          isCurrent ? `第 ${w} 周 · 本周` : `第 ${w} 周`,
        weekCorner: (w: number) => `W${String(w).padStart(2, "0")}`,
        weekdays: ["周一", "周二", "周三", "周四", "周五", "周六", "周日"],
        catCourse: "课程",
        catExam: "考试",
        catEvent: "日程",
        catBusy: "忙碌",
        rowTime: "时间",
        rowLocation: "地点",
        rowSubtitle: "教师 / 备注",
        rowWeeks: "周次",
        sectionSingle: (s: number) => `第 ${s} 节`,
        sectionRange: (a: number, b: number) => `第 ${a}-${b} 节`,
        weeksValue: (list: number[]) => `第 ${list.join("、")} 周`,
        expPrefix: "EXP",
        loading: "LOADING",
        errUnavailable: "链接已失效",
        errMissing: "链接无效",
        errNetwork: "网络异常",
        prevAria: "上一周",
        nextAria: "下一周",
        closeAria: "关闭",
      },
      en: {
        scheduleSuffix: "Schedule",
        defaultTitle: "Schedule",
        maskedTag: "MASKED",
        thisWeek: "Today",
        weekOption: (w: number, isCurrent: boolean) =>
          isCurrent ? `Week ${w} · Now` : `Week ${w}`,
        weekCorner: (w: number) => `W${String(w).padStart(2, "0")}`,
        weekdays: ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"],
        catCourse: "Course",
        catExam: "Exam",
        catEvent: "Event",
        catBusy: "Busy",
        rowTime: "Time",
        rowLocation: "Location",
        rowSubtitle: "Teacher / Note",
        rowWeeks: "Weeks",
        sectionSingle: (s: number) => `Period ${s}`,
        sectionRange: (a: number, b: number) => `Periods ${a}-${b}`,
        weeksValue: (list: number[]) => `W${list.join(", ")}`,
        expPrefix: "EXP",
        loading: "LOADING",
        errUnavailable: "LINK EXPIRED",
        errMissing: "INVALID LINK",
        errNetwork: "NETWORK ERROR",
        prevAria: "Previous week",
        nextAria: "Next week",
        closeAria: "Close",
      },
    } as const

    const locale = detectLocale()
    const dict = I18N[locale]
    document.documentElement.lang = locale === "zh" ? "zh-CN" : "en"

    // Subtle distinct left-border accents for courses while preserving the Bad Apple chiaroscuro frame
    const COURSE_ACCENTS = [
      "#0a0a0a",
      "#4d7c0f",
      "#0f766e",
      "#1d4ed8",
      "#6d28d9",
      "#be123c",
      "#b45309",
      "#374151",
    ]
    const COURSE_ACCENTS_DARK = [
      "#ffffff",
      "#a3e635",
      "#2dd4bf",
      "#60a5fa",
      "#a78bfa",
      "#fb7185",
      "#fbbf24",
      "#9ca3af",
    ]

    const ROW_HEIGHT = 56

    function hashString(input: string): number {
      let hash = 0
      for (let i = 0; i < input.length; i += 1) {
        hash = (hash * 31 + input.charCodeAt(i)) | 0
      }
      return Math.abs(hash)
    }

    function parseIsoDate(iso: string): Date | null {
      const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso)
      if (!m) return null
      return new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]), 12, 0, 0)
    }

    function formatIsoDate(date: Date): string {
      const y = date.getFullYear()
      const m = String(date.getMonth() + 1).padStart(2, "0")
      const d = String(date.getDate()).padStart(2, "0")
      return `${y}-${m}-${d}`
    }

    function addDays(base: Date, days: number): Date {
      const copy = new Date(base.getTime())
      copy.setDate(copy.getDate() + days)
      return copy
    }

    function parseClockMinutes(time: string | undefined): number | null {
      if (!time) return null
      const m = /^(\d{1,2}):(\d{2})/.exec(time.trim())
      if (!m) return null
      const h = Number(m[1])
      const min = Number(m[2])
      if (h > 23 || min > 59) return null
      return h * 60 + min
    }

    function computeCurrentWeek(termStartDate: string | undefined, totalWeeks: number): number {
      if (!termStartDate) return 1
      const start = parseIsoDate(termStartDate)
      if (!start) return 1
      const today = new Date()
      const todayNoon = new Date(today.getFullYear(), today.getMonth(), today.getDate(), 12, 0, 0)
      const diffDays = Math.floor((todayNoon.getTime() - start.getTime()) / (24 * 60 * 60 * 1000))
      const week = Math.floor(diffDays / 7) + 1
      return Math.min(Math.max(1, week), Math.max(1, totalWeeks))
    }

    function formatDateShort(ts: number): string {
      const d = new Date(ts)
      const y = d.getFullYear()
      const m = String(d.getMonth() + 1).padStart(2, "0")
      const day = String(d.getDate()).padStart(2, "0")
      return `${y}-${m}-${day}`
    }

    function categoryLabel(category: SharedItem["category"]): string {
      if (category === "busy") return dict.catBusy
      if (category === "exam") return dict.catExam
      if (category === "event") return dict.catEvent
      return dict.catCourse
    }

    function itemAppliesToWeek(
      item: SharedItem,
      week: number,
      weekStartIso: string | null,
      weekEndIso: string | null
    ): boolean {
      if (item.date) {
        if (!weekStartIso || !weekEndIso) return true
        return item.date >= weekStartIso && item.date <= weekEndIso
      }
      if (Array.isArray(item.weekList) && item.weekList.length > 0) {
        return item.weekList.includes(week)
      }
      return true
    }

    interface TimedPeriod {
      section: number
      startMin: number
      endMin: number
    }

    /** Maps a clock minute onto vertical pixel position in the period grid. */
    function minuteToGridY(minute: number, timedPeriods: TimedPeriod[], maxSection: number): number {
      if (timedPeriods.length === 0) {
        const clamped = Math.min(22 * 60, Math.max(8 * 60, minute))
        return ((clamped - 8 * 60) / (14 * 60)) * (maxSection * ROW_HEIGHT)
      }
      const first = timedPeriods[0]!
      if (minute <= first.startMin) {
        return (first.section - 1) * ROW_HEIGHT
      }
      for (let i = 0; i < timedPeriods.length; i += 1) {
        const p = timedPeriods[i]!
        const topY = (p.section - 1) * ROW_HEIGHT
        const bottomY = p.section * ROW_HEIGHT
        if (minute <= p.endMin) {
          const span = Math.max(1, p.endMin - p.startMin)
          const ratio = Math.min(1, Math.max(0, (minute - p.startMin) / span))
          return topY + ratio * ROW_HEIGHT
        }
        const next = timedPeriods[i + 1]
        if (next && minute < next.startMin) {
          const gap = Math.max(1, next.startMin - p.endMin)
          const ratio = (minute - p.endMin) / gap
          const nextTopY = (next.section - 1) * ROW_HEIGHT
          return bottomY + ratio * Math.max(0, nextTopY - bottomY)
        }
      }
      const last = timedPeriods[timedPeriods.length - 1]!
      return last.section * ROW_HEIGHT
    }

    interface PositionedCard {
      item: SharedItem
      top: number
      bottom: number
      col: number
      totalCols: number
    }

    function layoutDayCards(
      items: SharedItem[],
      timedPeriods: TimedPeriod[],
      maxSection: number
    ): PositionedCard[] {
      const totalHeight = maxSection * ROW_HEIGHT
      const raw: PositionedCard[] = []

      for (const item of items) {
        let top = 0
        let bottom = ROW_HEIGHT
        if (
          typeof item.startSection === "number" &&
          typeof item.endSection === "number" &&
          item.startSection >= 1 &&
          item.endSection >= item.startSection
        ) {
          top = (item.startSection - 1) * ROW_HEIGHT + 2
          bottom = item.endSection * ROW_HEIGHT - 2
        } else {
          const sMin = parseClockMinutes(item.startTime)
          const eMin = parseClockMinutes(item.endTime)
          if (sMin === null) continue
          const effectiveEnd = eMin !== null && eMin > sMin ? eMin : sMin + 45
          top = Math.max(2, minuteToGridY(sMin, timedPeriods, maxSection) + 2)
          bottom = Math.min(
            totalHeight - 2,
            Math.max(top + ROW_HEIGHT * 0.72, minuteToGridY(effectiveEnd, timedPeriods, maxSection) - 2)
          )
        }
        raw.push({ item, top, bottom, col: 0, totalCols: 1 })
      }

      raw.sort((a, b) => a.top - b.top || b.bottom - a.bottom)

      // Assign side-by-side columns for overlapping cards within clusters
      let cluster: PositionedCard[] = []
      let clusterMaxBottom = -1

      const flushCluster = () => {
        if (cluster.length === 0) return
        const colEnds: number[] = []
        for (const card of cluster) {
          let assigned = -1
          for (let c = 0; c < colEnds.length; c += 1) {
            if (colEnds[c]! <= card.top + 1) {
              assigned = c
              break
            }
          }
          if (assigned === -1) {
            assigned = colEnds.length
            colEnds.push(card.bottom)
          } else {
            colEnds[assigned] = card.bottom
          }
          card.col = assigned
        }
        const total = Math.max(1, colEnds.length)
        for (const card of cluster) {
          card.totalCols = total
        }
        cluster = []
        clusterMaxBottom = -1
      }

      for (const card of raw) {
        if (cluster.length > 0 && card.top >= clusterMaxBottom - 1) {
          flushCluster()
        }
        cluster.push(card)
        clusterMaxBottom = Math.max(clusterMaxBottom, card.bottom)
      }
      flushCluster()

      return raw
    }

    const titleEl = document.getElementById("share-title")!
    const maskedTagEl = document.getElementById("share-masked-tag")!
    const expTagEl = document.getElementById("share-exp-tag")!
    const weekControlsEl = document.getElementById("week-controls")!
    const prevBtn = document.getElementById("btn-prev-week") as HTMLButtonElement
    const nextBtn = document.getElementById("btn-next-week") as HTMLButtonElement
    const currentWeekBtn = document.getElementById("btn-current-week") as HTMLButtonElement
    const weekSelect = document.getElementById("week-select") as HTMLSelectElement
    const loadingEl = document.getElementById("share-loading")!
    const loadingLabelEl = document.getElementById("loading-label")!
    const errorEl = document.getElementById("share-error")!
    const errorTitleEl = document.getElementById("share-error-title")!
    const mainEl = document.getElementById("share-main")!
    const headerGridEl = document.getElementById("timetable-header")!
    const bodyGridEl = document.getElementById("timetable-body")!
    const footerFrameEl = document.getElementById("footer-frame")!

    const detailModalEl = document.getElementById("detail-modal")!
    const detailCloseEl = document.getElementById("detail-close")!
    const detailCategoryEl = document.getElementById("detail-category")!
    const detailTitleEl = document.getElementById("detail-title")!
    const detailRowsEl = document.getElementById("detail-rows")!

    loadingLabelEl.textContent = dict.loading
    currentWeekBtn.textContent = dict.thisWeek
    prevBtn.setAttribute("aria-label", dict.prevAria)
    nextBtn.setAttribute("aria-label", dict.nextAria)
    detailCloseEl.setAttribute("aria-label", dict.closeAria)

    function showError(label: string): void {
      loadingEl.classList.add("hidden")
      mainEl.classList.add("hidden")
      weekControlsEl.classList.add("hidden")
      errorEl.classList.remove("hidden")
      titleEl.textContent = dict.defaultTitle
      errorTitleEl.textContent = label
    }

    function openDetail(item: SharedItem): void {
      detailCategoryEl.textContent = categoryLabel(item.category)
      detailTitleEl.textContent = item.title
      detailRowsEl.replaceChildren()

      const addRow = (label: string, value: string) => {
        const row = document.createElement("div")
        row.className = "flex items-start justify-between gap-3 pt-2"
        row.style.borderTop = "1px solid var(--ink-hairline)"
        const dt = document.createElement("dt")
        dt.className = "shrink-0"
        dt.style.color = "var(--ink-soft)"
        dt.textContent = label
        const dd = document.createElement("dd")
        dd.className = "text-right font-medium"
        dd.textContent = value
        row.append(dt, dd)
        detailRowsEl.append(row)
      }

      const dayLabel = dict.weekdays[(item.weekDay - 1) % 7] ?? ""
      const sectionLabel =
        item.startSection && item.endSection
          ? item.startSection === item.endSection
            ? dict.sectionSingle(item.startSection)
            : dict.sectionRange(item.startSection, item.endSection)
          : ""
      const timeRange =
        item.startTime && item.endTime ? `${item.startTime}–${item.endTime}` : ""
      addRow(
        dict.rowTime,
        [item.date || dayLabel, sectionLabel, timeRange].filter(Boolean).join(" · ")
      )
      if (item.location) addRow(dict.rowLocation, item.location)
      if (item.subtitle) addRow(dict.rowSubtitle, item.subtitle)
      if (item.weekList && item.weekList.length > 0) {
        addRow(dict.rowWeeks, dict.weeksValue(item.weekList))
      }

      detailModalEl.classList.remove("hidden")
    }

    function closeDetail(): void {
      detailModalEl.classList.add("hidden")
    }

    detailCloseEl.addEventListener("click", closeDetail)
    detailModalEl.addEventListener("click", (event) => {
      if (event.target === detailModalEl) closeDetail()
    })
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeDetail()
    })

    const darkQuery = window.matchMedia("(prefers-color-scheme: dark)")

    function renderWeek(payload: SharedPayload, week: number, currentWeek: number): void {
      const isDark = darkQuery.matches
      const periods =
        payload.periods.length > 0
          ? [...payload.periods].sort((a, b) => a.section - b.section)
          : Array.from({ length: 12 }, (_, idx) => ({
              section: idx + 1,
              startTime: "",
              endTime: "",
            }))
      const maxSection = Math.max(
        periods.length,
        ...periods.map((p) => p.section),
        ...payload.items.map((i) => i.endSection ?? 0),
        10
      )
      const periodBySection = new Map(periods.map((p) => [p.section, p]))
      const timedPeriods: TimedPeriod[] = periods
        .map((p) => {
          const s = parseClockMinutes(p.startTime)
          const e = parseClockMinutes(p.endTime)
          return s !== null && e !== null && e > s ? { section: p.section, startMin: s, endMin: e } : null
        })
        .filter((p): p is TimedPeriod => p !== null)

      const termStart = payload.termStartDate ? parseIsoDate(payload.termStartDate) : null
      const weekMonday = termStart ? addDays(termStart, (week - 1) * 7) : null
      const weekStartIso = weekMonday ? formatIsoDate(weekMonday) : null
      const weekEndIso = weekMonday ? formatIsoDate(addDays(weekMonday, 6)) : null
      const todayIso = formatIsoDate(new Date())

      // Header row
      headerGridEl.replaceChildren()
      const corner = document.createElement("div")
      corner.className = "flex items-center justify-center py-2.5 font-mono text-[10px] font-semibold tracking-widest"
      corner.style.borderRight = "1px solid var(--ink-faint)"
      corner.style.color = "var(--ink-soft)"
      corner.textContent = dict.weekCorner(week)
      headerGridEl.append(corner)

      for (let day = 1; day <= 7; day += 1) {
        const cell = document.createElement("div")
        const dayDate = weekMonday ? addDays(weekMonday, day - 1) : null
        const dayIso = dayDate ? formatIsoDate(dayDate) : null
        const isToday = dayIso === todayIso

        cell.className = "flex flex-col items-center justify-center py-2 text-center"
        if (day < 7) cell.style.borderRight = "1px solid var(--ink-hairline)"
        if (isToday) {
          cell.style.background = "var(--ink)"
          cell.style.color = "var(--paper)"
        }

        const label = document.createElement("span")
        label.className = "text-xs font-semibold tracking-wider"
        label.textContent = dict.weekdays[day - 1]!
        cell.append(label)

        if (dayDate) {
          const dateSpan = document.createElement("span")
          dateSpan.className = "mt-0.5 font-mono text-[10px]"
          dateSpan.style.opacity = isToday ? "0.8" : "0.5"
          dateSpan.textContent = `${dayDate.getMonth() + 1}/${dayDate.getDate()}`
          cell.append(dateSpan)
        }
        headerGridEl.append(cell)
      }

      // Grid body
      bodyGridEl.replaceChildren()
      const totalHeight = maxSection * ROW_HEIGHT

      // Period sidebar
      const timeCol = document.createElement("div")
      timeCol.style.borderRight = "1px solid var(--ink-faint)"
      for (let section = 1; section <= maxSection; section += 1) {
        const period = periodBySection.get(section)
        const cell = document.createElement("div")
        cell.style.height = `${ROW_HEIGHT}px`
        if (section < maxSection) cell.style.borderBottom = "1px solid var(--ink-hairline)"
        cell.className = "flex flex-col items-center justify-center px-1 text-center"

        const num = document.createElement("span")
        num.className = "font-mono text-xs font-semibold"
        num.textContent = String(section)
        cell.append(num)

        if (period?.startTime) {
          const time = document.createElement("span")
          time.className = "font-mono text-[10px] leading-tight"
          time.style.color = "var(--ink-soft)"
          time.textContent = period.startTime
          cell.append(time)
        }
        timeCol.append(cell)
      }
      bodyGridEl.append(timeCol)

      // All week items (courses, exams, personal events) render directly in the grid!
      const weekItems = payload.items.filter((item) =>
        itemAppliesToWeek(item, week, weekStartIso, weekEndIso)
      )

      const accents = isDark ? COURSE_ACCENTS_DARK : COURSE_ACCENTS

      for (let day = 1; day <= 7; day += 1) {
        const dayDate = weekMonday ? addDays(weekMonday, day - 1) : null
        const isToday = dayDate ? formatIsoDate(dayDate) === todayIso : false

        const col = document.createElement("div")
        col.style.height = `${totalHeight}px`
        if (day < 7) col.style.borderRight = "1px solid var(--ink-hairline)"
        if (isToday) col.style.background = "var(--surface-subtle)"
        col.className = "relative"

        for (let section = 1; section <= maxSection; section += 1) {
          const line = document.createElement("div")
          line.style.height = `${ROW_HEIGHT}px`
          if (section < maxSection) line.style.borderBottom = "1px solid var(--ink-hairline)"
          col.append(line)
        }

        const dayItems = weekItems.filter((item) => item.weekDay === day)
        const positioned = layoutDayCards(dayItems, timedPeriods, maxSection)

        for (const card of positioned) {
          const { item, top, bottom, col: cardCol, totalCols } = card
          const btn = document.createElement("button")
          btn.type = "button"
          btn.style.top = `${top}px`
          btn.style.height = `${Math.max(32, bottom - top)}px`
          const widthPct = 100 / totalCols
          btn.style.left = `calc(${cardCol * widthPct}% + 3px)`
          btn.style.width = `calc(${widthPct}% - 6px)`

          const kindClass =
            item.category === "busy"
              ? "ba-card-busy"
              : item.category === "exam"
                ? "ba-card-exam"
                : item.category === "event"
                  ? "ba-card-event"
                  : "ba-card-course"
          btn.className = `ba-card ${kindClass}`

          if (item.category === "course") {
            btn.style.borderLeftColor = accents[hashString(item.title) % accents.length]!
          }

          const titleSpan = document.createElement("span")
          titleSpan.className = "line-clamp-2 text-[11px] font-semibold leading-tight"
          titleSpan.textContent = item.title
          btn.append(titleSpan)

          if (item.location) {
            const locSpan = document.createElement("span")
            locSpan.className = "mt-0.5 line-clamp-2 text-[10px] leading-tight opacity-75"
            locSpan.textContent = item.location
            btn.append(locSpan)
          } else if (
            (item.category === "exam" || item.category === "event") &&
            item.startTime &&
            item.endTime
          ) {
            const timeSpan = document.createElement("span")
            timeSpan.className = "mt-0.5 font-mono text-[10px] leading-tight opacity-75"
            timeSpan.textContent = `${item.startTime}-${item.endTime}`
            btn.append(timeSpan)
          }

          btn.addEventListener("click", () => openDetail(item))
          col.append(btn)
        }

        bodyGridEl.append(col)
      }

      // Sync controls & footer frame counter
      weekSelect.value = String(week)
      prevBtn.disabled = week <= 1
      nextBtn.disabled = week >= payload.totalWeeks
      footerFrameEl.textContent = `${dict.weekCorner(week)} / ${String(payload.totalWeeks).padStart(2, "0")}`
      if (payload.termStartDate && week !== currentWeek) {
        currentWeekBtn.classList.remove("hidden")
      } else {
        currentWeekBtn.classList.add("hidden")
      }
    }

    async function init(): Promise<void> {
      const params = new URLSearchParams(window.location.search)
      const shareId = (params.get("id") || "").trim()
      if (!shareId) {
        showError(dict.errMissing)
        return
      }

      try {
        const res = await fetch(`/api/share?id=${encodeURIComponent(shareId)}`)
        if (res.status === 404 || res.status === 400) {
          showError(dict.errUnavailable)
          return
        }
        if (!res.ok) {
          showError(`HTTP ${res.status}`)
          return
        }

        const data = (await res.json()) as {
          payload?: SharedPayload
          updatedAt?: number | null
          expiresAt?: number | null
        }
        const payload = data.payload
        if (!payload || payload.version !== 1 || !Array.isArray(payload.items)) {
          showError(dict.errUnavailable)
          return
        }

        const displayTitle = payload.semester
          ? `${payload.semester} · ${dict.scheduleSuffix}`
          : dict.defaultTitle
        document.title = `${displayTitle} · ORAHAKO`
        titleEl.textContent = displayTitle

        if (payload.masked) {
          maskedTagEl.textContent = dict.maskedTag
          maskedTagEl.classList.remove("hidden")
        }
        if (data.expiresAt) {
          expTagEl.textContent = `${dict.expPrefix} ${formatDateShort(data.expiresAt)}`
          expTagEl.classList.remove("hidden")
        }

        const totalWeeks = Math.max(1, payload.totalWeeks || 20)
        const currentWeek = computeCurrentWeek(payload.termStartDate, totalWeeks)
        let activeWeek = currentWeek

        weekSelect.replaceChildren()
        for (let w = 1; w <= totalWeeks; w += 1) {
          const opt = document.createElement("option")
          opt.value = String(w)
          opt.textContent = dict.weekOption(w, Boolean(payload.termStartDate && w === currentWeek))
          weekSelect.append(opt)
        }

        const setWeek = (next: number) => {
          activeWeek = Math.min(totalWeeks, Math.max(1, next))
          renderWeek(payload, activeWeek, currentWeek)
        }

        prevBtn.addEventListener("click", () => setWeek(activeWeek - 1))
        nextBtn.addEventListener("click", () => setWeek(activeWeek + 1))
        currentWeekBtn.addEventListener("click", () => setWeek(currentWeek))
        weekSelect.addEventListener("change", () => setWeek(Number(weekSelect.value)))
        darkQuery.addEventListener("change", () => renderWeek(payload, activeWeek, currentWeek))

        loadingEl.classList.add("hidden")
        weekControlsEl.classList.remove("hidden")
        weekControlsEl.classList.add("flex")
        mainEl.classList.remove("hidden")

        setWeek(currentWeek)
      } catch {
        showError(dict.errNetwork)
      }
    }

    init()
  </script>
</Layout>
