{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "paths": {
      "@orahako/sdk": ["./packages/core/sdk/src/index.ts"],
      "@orahako/kernel": ["./packages/core/kernel/src/index.ts"],
      "@orahako/ui-primitives": ["./packages/core/ui-primitives/src/index.ts"],
      "@orahako/runtime-slots": ["./packages/runtime/slots/src/index.ts"],
      "@orahako/runtime-router": ["./packages/runtime/router/src/index.ts"],
      "@orahako/runtime-ui": ["./packages/runtime/ui/src/index.ts"],
      "@orahako/runtime-i18n": ["./packages/runtime/i18n/src/index.ts"],
      "@orahako/runtime-settings": ["./packages/runtime/settings/src/index.ts"],
      "@orahako/runtime-storage": ["./packages/runtime/storage/src/index.ts"],
      "@orahako/runtime-http": ["./packages/runtime/http/src/index.ts"],
      "@orahako/runtime-native": ["./packages/runtime/native/src/index.ts"],
      "@orahako/runtime-packages": ["./packages/runtime/packages/src/index.ts"],
      "@orahako/academic-sdk": ["./packages/edu/sdk/src/index.ts"],
      "@orahako/academic-kit": ["./packages/edu/kit/src/index.ts"],
      "@orahako/academic-runtime": ["./packages/edu/runtime/src/index.ts"],
      "@orahako/theme-default": ["./packages/client/theme-default/src/index.ts"],
      "@orahako/ui-activation": ["./packages/client/ui-activation/src/index.ts"],
      "@orahako/ui-analytics": ["./packages/client/ui-analytics/src/index.ts"],
      "@orahako/ui-announcement": ["./packages/client/ui-announcement/src/index.ts"],
      "@orahako/ui-mfa": ["./packages/client/ui-mfa/src/index.ts"],
      "@orahako/ui-network-activity": ["./packages/client/ui-network-activity/src/index.ts"],
      "@orahako/ui-plugin-manager": ["./packages/client/ui-plugin-manager/src/index.ts"],
      "@orahako/ui-profile": ["./packages/client/ui-profile/src/index.ts"],
      "@orahako/ui-settings": ["./packages/client/ui-settings/src/index.ts"],
      "@orahako/ui-shell": ["./packages/client/ui-shell/src/index.ts"],
      "@orahako/ui-updater": ["./packages/client/ui-updater/src/index.ts"],
      "@orahako/plugin-notifications": ["./packages/plugins/notifications/src/index.ts"],
      "@orahako/plugin-onboarding": ["./packages/plugins/onboarding/src/index.ts"],
      "@orahako/plugin-overview": ["./packages/plugins/overview/src/index.ts"],
      "@orahako/plugin-ui-auth": ["./packages/plugins/ui-auth/src/index.ts"],
      "@orahako/plugin-ysu-provider": ["./packages/plugins/ysu-provider/src/index.ts"]
    }
  },
  "include": [
    "packages/*/*/src/**/*.ts",
    "packages/*/*/src/**/*.tsx",
    "packages/*/*/tests/**/*.ts",
    "packages/*/*/tests/**/*.tsx"
  ]
}
