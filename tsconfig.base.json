{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "paths": {
      "@orahako/sdk": ["./packages/core/sdk/src/index.ts"],
      "@orahako/kernel": ["./packages/core/kernel/src/index.ts"],
      "@orahako/ui-primitives": ["./packages/core/ui-primitives/src/index.ts"],
      "@orahako/runtime-slots": ["./packages/runtime/slots/src/index.ts"],
      "@orahako/runtime-router": ["./packages/runtime/router/src/index.ts"],
      "@orahako/runtime-ui": ["./packages/runtime/ui/src/index.ts"],
      "@orahako/runtime-i18n": ["./packages/runtime/i18n/src/index.ts"],
      "@orahako/runtime-settings": ["./packages/runtime/settings/src/index.ts"],
      "@orahako/runtime-storage": ["./packages/runtime/storage/src/index.ts"],
      "@orahako/runtime-http": ["./packages/runtime/http/src/index.ts"],
      "@orahako/runtime-native": ["./packages/runtime/native/src/index.ts"],
      "@orahako/runtime-packages": ["./packages/runtime/packages/src/index.ts"],
      "@orahako/academic-sdk": ["./packages/edu/sdk/src/index.ts"],
      "@orahako/academic-kit": ["./packages/edu/kit/src/index.ts"],
      "@orahako/academic-runtime": ["./packages/edu/runtime/src/index.ts"]
    }
  },
  "include": [
    "packages/*/*/src/**/*.ts",
    "packages/*/*/src/**/*.tsx",
    "packages/*/*/tests/**/*.ts",
    "packages/*/*/tests/**/*.tsx"
  ]
}
