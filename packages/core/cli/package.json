{
  "name": "@orahako/cli",
  "version": "0.1.0",
  "description": "Plugin packer and developer CLI for Orahako API v1 plugins.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Youwenqwq/orahako.git",
    "directory": "packages/core/cli"
  },
  "type": "module",
  "bin": {
    "orahako": "./dist/bin.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@orahako/sdk": "workspace:*",
    "@tailwindcss/postcss": "^4.3.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "postcss": "8.5.15",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@orahako/kernel": "workspace:*",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
