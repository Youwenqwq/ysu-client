{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@orahako/sdk": [
        "./packages/core/sdk/src/index.ts"
      ],
      "@orahako/kernel": [
        "./packages/core/kernel/src/index.ts"
      ],
      "@orahako/ui-primitives": [
        "./packages/core/ui-primitives/src/index.ts"
      ],
      "@orahako/runtime-slots": [
        "./packages/runtime/slots/src/index.ts"
      ],
      "@orahako/runtime-router": [
        "./packages/runtime/router/src/index.ts"
      ],
      "@orahako/runtime-ui": [
        "./packages/runtime/ui/src/index.ts"
      ],
      "@orahako/runtime-i18n": [
        "./packages/runtime/i18n/src/index.ts"
      ],
      "@orahako/runtime-settings": [
        "./packages/runtime/settings/src/index.ts"
      ],
      "@orahako/runtime-storage": [
        "./packages/runtime/storage/src/index.ts"
      ],
      "@orahako/runtime-http": [
        "./packages/runtime/http/src/index.ts"
      ],
      "@orahako/runtime-native": [
        "./packages/runtime/native/src/index.ts"
      ],
      "@orahako/runtime-packages": [
        "./packages/runtime/packages/src/index.ts"
      ],
      "@orahako/academic-sdk": [
        "./packages/edu/sdk/src/index.ts"
      ],
      "@orahako/academic-kit": [
        "./packages/edu/kit/src/index.ts"
      ],
      "@orahako/academic-runtime": [
        "./packages/edu/runtime/src/index.ts"
      ],
      "@orahako/theme-default": [
        "./packages/client/theme-default/src/index.ts"
      ],
      "@orahako/ui-activation": [
        "./packages/client/ui-activation/src/index.ts"
      ],
      "@orahako/ui-analytics": [
        "./packages/client/ui-analytics/src/index.ts"
      ],
      "@orahako/ui-announcement": [
        "./packages/client/ui-announcement/src/index.ts"
      ],
      "@orahako/ui-mfa": [
        "./packages/client/ui-mfa/src/index.ts"
      ],
      "@orahako/ui-network-activity": [
        "./packages/client/ui-network-activity/src/index.ts"
      ],
      "@orahako/ui-plugin-manager": [
        "./packages/client/ui-plugin-manager/src/index.ts"
      ],
      "@orahako/ui-profile": [
        "./packages/client/ui-profile/src/index.ts"
      ],
      "@orahako/ui-settings": [
        "./packages/client/ui-settings/src/index.ts"
      ],
      "@orahako/ui-shell": [
        "./packages/client/ui-shell/src/index.ts"
      ],
      "@orahako/ui-updater": [
        "./packages/client/ui-updater/src/index.ts"
      ],
      "@orahako/plugin-notifications": [
        "./packages/plugins/notifications/src/index.ts"
      ],
      "@orahako/plugin-onboarding": [
        "./packages/plugins/onboarding/src/index.ts"
      ],
      "@orahako/plugin-overview": [
        "./packages/plugins/overview/src/index.ts"
      ],
      "@orahako/plugin-ui-auth": [
        "./packages/plugins/ui-auth/src/index.ts"
      ],
      "@orahako/plugin-ysu-provider": [
        "./packages/plugins/ysu-provider/src/index.ts"
      ],
      "@orahako/plugin-comprehensive": [
        "./packages/plugins/comprehensive/src/index.ts"
      ],
      "@orahako/plugin-credits": [
        "./packages/plugins/credits/src/index.ts"
      ],
      "@orahako/plugin-ecard": [
        "./packages/plugins/ecard/src/index.ts"
      ],
      "@orahako/plugin-epay": [
        "./packages/plugins/epay/src/index.ts"
      ],
      "@orahako/plugin-evaluation": [
        "./packages/plugins/evaluation/src/index.ts"
      ],
      "@orahako/plugin-exams": [
        "./packages/plugins/exams/src/index.ts"
      ],
      "@orahako/plugin-grades": [
        "./packages/plugins/grades/src/index.ts"
      ],
      "@orahako/plugin-labor": [
        "./packages/plugins/labor/src/index.ts"
      ],
      "@orahako/plugin-makeup-exams": [
        "./packages/plugins/makeup-exams/src/index.ts"
      ],
      "@orahako/plugin-meter": [
        "./packages/plugins/meter/src/index.ts"
      ],
      "@orahako/plugin-student-info": [
        "./packages/plugins/student-info/src/index.ts"
      ],
      "@orahako/plugin-training-plan": [
        "./packages/plugins/training-plan/src/index.ts"
      ],
      "@orahako/plugin-schedule": [
        "./packages/plugins/schedule/src/index.ts"
      ],
      "@orahako/plugin-school-schedule": [
        "./packages/plugins/school-schedule/src/index.ts"
      ],
      "@orahako/bundle-platform": [
        "./packages/bundle/platform/src/index.ts"
      ],
      "@orahako/bundle-academic": [
        "./packages/bundle/academic/src/index.ts"
      ],
      "@orahako/bundle-ysu": [
        "./packages/bundle/ysu/src/index.ts"
      ],
      "@orahako/bundle-ysu/identity": [
        "./packages/bundle/ysu/src/identity.json"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "dist/types/**/*.ts",
    "dist/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "website",
    "android",
    "packages/core",
    "packages/runtime",
    "packages/edu",
    "packages/client",
    "packages/plugins"
  ]
}
