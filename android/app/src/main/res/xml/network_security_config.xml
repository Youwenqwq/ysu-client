<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置：默认禁止明文流量，仅放行以下主机：
  - 202.206.247.49：双创平台（ysu_pt / ysu_xf），裸 IP 部署，无 HTTPS；
  - xgxt.ysu.edu.cn：学工系统的 CAS service 登记为 http 方案，授权链
    必经一跳 http（携带一次性 ST 票据）后由服务端 301 到 https，
    会话 cookie 均在 https 下建立。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">202.206.247.49</domain>
        <domain includeSubdomains="false">xgxt.ysu.edu.cn</domain>
    </domain-config>
</network-security-config>
